{
  "name": "prorab",
  "version": "0.2.0",
  "description": "Autonomous task execution CLI powered by Claude Agent SDK, OpenCode, CCS, Codex, and Ollama",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "prorab": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && cd ui && npm run build",
    "build:server": "tsc",
    "build:ui": "cd ui && npm run build",
    "typecheck:ui": "cd ui && npm run typecheck",
    "dev": "tsc --watch",
    "dev:server": "tsc --watch",
    "dev:ui": "cd ui && npm run dev",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.250",
    "@anthropic-ai/sdk": "^0.122.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": ">=0.150.0 <1.0.0",
    "@opencode-ai/sdk": "^1.18.25",
    "commander": "^15.0.0",
    "fastify": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
